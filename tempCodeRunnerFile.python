# else: 
#     print("Largest number is ",c)




class Solution():
    def target(self,nums:list,t):

        result=[]
        n=len(nums)
        for i in range(0,n-1):
            
            if nums[i]+nums[i+1]==t:
                result.append(nums[i])
                result.append(nums[i+1])
                i+=1
        return result

obj = Solution()
print("Output is: ",obj.target([2,7,11,15],9))


